# iPodOS26 WPS Layout #
# Disable Default Status Bar
%wd

# 1. Load your backdrop image (Already working!)
%X(iPodOS26WPS.bmp)

# Preload Interactive Bitmaps
%xl(S,ShuffleON.bmp,0,0)
%xl(R,RepeatON.bmp,0,0)

# Battery graphics
%xl(H,batterydead.bmp,0,0)
%xl(I,battery1.bmp,0,0)
%xl(J,battery2.bmp,0,0)
%xl(K,battery3.bmp,0,0)
%xl(L,battery4.bmp,0,0)
%xl(M,battery5.bmp,0,0)
%xl(N,battery6.bmp,0,0)
%xl(O,battery7.bmp,0,0)
%xl(P,battery8.bmp,0,0)
%xl(Q,battery9.bmp,0,0)
%xl(Z,battery10.bmp,0,0)
%xl(X,batteryfull.bmp,0,0)

%V(100,5,120,20,1)
%ac%cH:%cM

%V(266,12,17,9,-)
%?bl<%xd(H)|%xd(I)|%xd(J)|%xd(K)|%xd(L)|%xd(M)|%xd(N)|%xd(O)|%xd(P)|%xd(Q)|%xd(R)|%xd(S)>

# 2. Add the Track Info Viewport (Song title)
%V(190,55,110,40,1)
%s%it

# 3. Add the Progress Slider Viewport 
%V(191,83,100,8,-)
%pb(0,0,100,8,progress_bar.bmp)

# 4. Add the Time Counter Viewport
%V(191,92,100,20,1)
%al%pc%ar-%pr


# ==========================================
# REPOSITIONED ELEMENTS & VERTICAL VOLUME
# ==========================================

# 5. Album Art Window (Left side)
%V(35,45,140,140,-)
%Cl(0,0,140,140,c,c)
%Cd

# 6. Vertical Volume Slider Control Bar (UPDATED WITH EXTREME PRECISION!)
# Placed perfectly over your glass pill layout at X=211, Y=122
# The box dimensions match your 36x87 pixel asset requirements exactly
%V(192,116,36,87,-)
%pv(0,0,36,87,SPKfull.bmp,vertical)

# 7. Shuffle Status Icon (Stacked to the right of your tall volume pill)
%V(248,116,39,39,-)
%?ps<%xd(S)|>

# 8. Repeat Status Icon (Stacked cleanly under Shuffle)
%V(248,164,39,39,-)
%?mm<|%xd(R)|%xd(R)|%xd(R)|%xd(R)>
